# =============================================================================
# Pay365 — Root Git Ignore
# =============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
*/node_modules/
.pnp
.pnp.js

# ── Environment & Secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# ── Production Build & Bundler Output ────────────────────────────────────────
dist/
*/dist/
dist-ssr/
build/
*/build/
out/
.vite/
.next/

# ── Testing & Coverage ───────────────────────────────────────────────────────
coverage/
*/coverage/
.nyc_output/
test-results/
playwright-report/

# ── Database & Prisma Local Storage ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sqlite-journal
backend/prisma/*.db
backend/prisma/*.sqlite

# ── Logs & Debugging ─────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Temporary & Scratch Files ────────────────────────────────────────────────
test-*.mjs
test-*.js
scratch/
*.tmp
*.temp

# ── IDE & Editor Specific ────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── Operating System ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ── Cache & Transpilation ────────────────────────────────────────────────────
*.tsbuildinfo
.eslintcache
.stylelintcache
.turbo/

# Explanation folder
explaination/

